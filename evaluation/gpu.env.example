# Copy to an ignored file such as evaluation/gpu.env and pass it with
# `docker compose --env-file evaluation/gpu.env ...`. Do not commit HF tokens.
LOCAL_MODEL=Qwen/Qwen3.5-4B
VLLM_IMAGE=vllm/vllm-openai:nightly
VLLM_PORT=8000
TENSOR_PARALLEL_SIZE=1
MAX_MODEL_LEN=16384
GPU_MEMORY_UTILIZATION=0.90
VLLM_DTYPE=auto
CUDA_VISIBLE_DEVICES=0
HF_CACHE_DIR=./.cache/huggingface
# HF_TOKEN=
